# --- General ---
PROVIDER=mock            # mock | gnani
DEBUG=0                  # 1 = include debug info in responses, log transcripts
CONFIRM_POLICY=adaptive  # adaptive | always | never (never/always are eval baselines)

# --- Gnani (fill ONLY from docs.gnani.ai; see docs/gnani_api_notes.md) ---
GNANI_API_KEY=
GNANI_LANG_CODE=te       # verify Telugu code in the docs

# Speech-to-text (Prisma)
GNANI_STT_URL=
GNANI_STT_AUTH=          # header template, e.g.  Header-Name: prefix {key}
GNANI_STT_MODE=multipart # multipart | json_base64
GNANI_STT_FILE_FIELD=file
GNANI_STT_FIELDS={}      # extra form/json fields, JSON; may use {lang}, e.g. {"language":"{lang}"}
GNANI_STT_AUDIO_FIELD=audio   # only for json_base64 mode: JSON key that receives base64 audio
GNANI_STT_TEXT_PATH=     # dotted path to transcript in the JSON response, e.g. data.text
GNANI_STT_CONF_PATH=     # optional dotted path to confidence

# Text-to-speech (Timbre)
GNANI_TTS_URL=
GNANI_TTS_AUTH=
GNANI_TTS_BODY={}        # JSON body template; may use {text} {lang} {voice}
GNANI_TTS_VOICE=
GNANI_TTS_RESPONSE=binary  # binary | base64
GNANI_TTS_AUDIO_PATH=    # dotted path to base64 audio when RESPONSE=base64
GNANI_TTS_MIME=audio/wav

GNANI_TIMEOUT_S=20
